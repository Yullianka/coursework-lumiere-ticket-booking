# Copy to .env in apps/api and replace the placeholder password.
PORT=3001
DATABASE_URL=postgresql://lumiere_app:replace-me@127.0.0.1:5432/lumiere
# Optional: a fresh empty disposable database, used only by npm run test:db.
# TEST_DATABASE_URL=postgresql://lumiere_app:replace-me@127.0.0.1:5432/lumiere_schema_test

# For HTTPS hosting; comma-separated exact browser origins.
# APP_ORIGIN=https://tickets.example.com
# NODE_ENV=production
# Bootstrap only; never commit real credentials.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-at-least-12-characters
# ADMIN_NAME=Lumiere Admin
