{
  "name": "@lumiere/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/scripts/database.ts migrate",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/scripts/database.ts seed",
    "db:check": "node --env-file-if-exists=.env --import tsx src/scripts/database.ts check",
    "test:db": "node --env-file-if-exists=.env --import tsx --test test/database/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
